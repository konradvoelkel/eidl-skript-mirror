\frametitle{Und jetzt logistisch}

  \begin{lstlisting}
    def forward(self, x):
        return torch.sigmoid(self.linear(x))   # <---

criterion = nn.BCELoss()                       # <---
  \end{lstlisting}

  \begin{center}
    \includegraphics[width=0.46\textwidth]{vl04-lin-vs-log-regression.png}
